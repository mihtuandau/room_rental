// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
  // This project (NestJS, no "type": "module" in package.json) is CommonJS —
  // the client must be generated as CJS to match, or Node fails to load it
  // (see the prisma-upgrade-v7 skill's esm-support reference).
  moduleFormat    = "cjs"
}

datasource db {
  provider   = "postgresql"
  // Search uses PostgreSQL's unaccent extension. PostGIS is intentionally not
  // required because the current schema stores latitude/longitude as decimals.
  extensions = [unaccent]
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  user
  admin
}

enum RoomType {
  boarding_house
  whole_house
  mini_apartment
  serviced_apartment
  shared_room
}

enum RoomStatus {
  draft
  pending
  active
  hidden
  rejected
  expired
}

enum ReportReason {
  fake_listing
  wrong_info
  scam
  already_rented
  other
}

enum ReportStatus {
  pending
  reviewing
  resolved
  dismissed
}

enum OtpPurpose {
  register
  reset_password
  change_phone
}

enum ContactType {
  phone
  zalo
  message
}

enum ModerationAction {
  submitted
  approved
  rejected
  hidden
  restored
  expired
  verified
  unverified
}

enum NotificationType {
  listing_approved
  listing_rejected
  saved_search_match
}

enum AmenityType {
  basic
  utility
  security
  nearby
}

// -----------------------------------------------------------------------------
// User & auth
// -----------------------------------------------------------------------------

model User {
  id String @id @default(cuid())

  // An account is identified by phone (password signup) or by Google (OAuth) —
  // both are optional so either signup path can create a valid user. Postgres
  // allows many NULLs under a unique index, so blanks never collide.
  phone        String? @unique
  passwordHash String? @map("password_hash")
  email        String? @unique
  googleId     String? @unique @map("google_id")

  fullName  String? @map("full_name")
  avatarUrl String? @map("avatar_url")

  // Contact info shown to tenants on a listing — may differ from the login phone.
  contactPhone String? @map("contact_phone")
  zaloUrl      String? @map("zalo_url")

  role            Role    @default(user)
  tokenVersion    Int     @default(0) @map("token_version")
  isPhoneVerified Boolean @default(false) @map("is_phone_verified")
  isEmailVerified Boolean @default(false) @map("is_email_verified")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  rooms           Room[]
  favorites       Favorite[]
  savedSearches   SavedSearch[]
  contactLogs     ContactLog[]
  roomViews       RoomView[]
  reports         Report[]         @relation("ReportedBy")
  resolvedReports Report[]         @relation("ResolvedBy")
  moderations     RoomModeration[]
  notifications   Notification[]

  @@index([role])
  @@map("users")
}

model OtpCode {
  id       String     @id @default(cuid())
  phone    String?
  email    String?
  codeHash String     @map("code_hash")
  purpose  OtpPurpose

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  attempts  Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@index([email, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

// -----------------------------------------------------------------------------
// Rooms
// -----------------------------------------------------------------------------

model Room {
  id      Int    @id @default(autoincrement())
  ownerId String @map("owner_id")
  // Restrict, not Cascade: a hard-delete of a User must not silently wipe out
  // their listings/history. Users are only ever soft-deleted (`deletedAt`).
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  title       String
  slug        String   @unique
  description String?
  roomType    RoomType @default(boarding_house) @map("room_type")

  price   Int
  area    Float?
  deposit Int?

  bedrooms     Int? @map("bedrooms")
  bathrooms    Int? @map("bathrooms")
  maxOccupants Int? @map("max_occupants")

  city      String
  district  String
  ward      String?
  address   String?
  latitude  Float?
  longitude Float?
  // geog geography(Point, 4326) — added via raw SQL in the migration, see add-prisma-model skill

  isVerified Boolean    @default(false) @map("is_verified")
  verifiedAt DateTime?  @map("verified_at")
  status     RoomStatus @default(pending)

  viewCount    Int @default(0) @map("view_count")
  contactCount Int @default(0) @map("contact_count")

  publishedAt DateTime? @map("published_at")
  expiresAt   DateTime? @map("expires_at")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  images        RoomImage[]
  amenities     RoomAmenity[]
  favorites     Favorite[]
  contactLogs   ContactLog[]
  roomViews     RoomView[]
  reports       Report[]
  moderations   RoomModeration[]
  notifications Notification[]

  @@index([status])
  @@index([city, district])
  @@index([price])
  @@index([roomType])
  @@index([ownerId])
  @@index([publishedAt])
  @@index([expiresAt])
  @@map("rooms")
}

model RoomImage {
  id     String @id @default(cuid())
  roomId Int    @map("room_id")
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  key      String // Cloudinary public_id
  url      String // Cloudinary secure_url
  isCover  Boolean @default(false) @map("is_cover")
  position Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  // A partial unique index enforcing "at most one cover image per room" is added
  // by hand to the generated migration (Prisma can't express partial indexes):
  //   CREATE UNIQUE INDEX room_one_cover_idx ON room_images(room_id) WHERE is_cover = true;
  @@index([roomId])
  @@index([roomId, position])
  @@unique([key])
  @@map("room_images")
}

model Landmark {
  id   Int    @id @default(autoincrement())
  name String
  type String // "school" | "industrial_park" | "hospital" | "university" ...

  city      String
  district  String
  latitude  Float
  longitude Float
  // geog geography(Point, 4326) — added via raw SQL in the migration, see add-prisma-model skill

  createdAt DateTime @default(now()) @map("created_at")

  @@index([city, district])
  @@map("landmarks")
}

// -----------------------------------------------------------------------------
// Amenities
// -----------------------------------------------------------------------------

model Amenity {
  id   Int         @id @default(autoincrement())
  name String
  slug String      @unique
  icon String?
  description String?
  type AmenityType @default(basic)
  isActive Boolean @default(true) @map("is_active")

  rooms RoomAmenity[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([type])
  @@map("amenities")
}

model RoomAmenity {
  roomId    Int @map("room_id")
  amenityId Int @map("amenity_id")

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomId, amenityId])
  @@index([amenityId])
  @@map("room_amenities")
}

// -----------------------------------------------------------------------------
// Tenant interactions
// -----------------------------------------------------------------------------

model Favorite {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId Int    @map("room_id")
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, roomId])
  @@map("favorites")
}

model SavedSearch {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  city     String?
  district String?
  ward     String?
  roomType RoomType? @map("room_type")

  priceMin Int?   @map("price_min")
  priceMax Int?   @map("price_max")
  areaMin  Float? @map("area_min")
  areaMax  Float? @map("area_max")

  lastNotifiedAt DateTime? @map("last_notified_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  notificationLogs NotificationLog[]

  @@index([userId])
  @@index([city, district])
  @@index([roomType])
  @@map("saved_searches")
}

model NotificationLog {
  id            String      @id @default(cuid())
  savedSearchId String      @map("saved_search_id")
  savedSearch   SavedSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  roomId        Int         @map("room_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([savedSearchId, roomId])
  @@map("notification_logs")
}

model Notification {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String?

  // Optional deep link — a listing-approved/rejected or saved-search-match
  // notification always has one, but the model stays open for a future type
  // that doesn't. SetNull, not Cascade: rooms are soft-deleted in practice, but
  // if one ever is hard-deleted the notification should still be readable.
  roomId Int?  @map("room_id")
  room   Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  isRead Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

model ContactLog {
  id     String @id @default(cuid())
  userId String @map("user_id")
  // Restrict: ContactLog is anti-abuse / landlord-stats data (HARD RULE #10 in
  // CLAUDE.md) — it must outlive a hard-delete attempt on the viewing user.
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  roomId Int    @map("room_id")
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  type ContactType

  createdAt DateTime @default(now()) @map("created_at")

  @@index([roomId])
  @@index([userId])
  @@index([roomId, type])
  @@map("contact_logs")
}

model RoomView {
  id     String  @id @default(cuid())
  roomId Int     @map("room_id")
  room   Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId String? @map("user_id")
  // Optional + SetNull: anonymous views are allowed, and history survives even
  // if the viewing user's account is later removed.
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  ipHash String? @map("ip_hash")
  // Daily anonymous-browser dedupe key. Nullable preserves legacy rows.
  dedupeKey String? @unique @map("dedupe_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([roomId, createdAt])
  @@index([userId])
  @@map("room_views")
}

// -----------------------------------------------------------------------------
// Moderation
// -----------------------------------------------------------------------------

model Report {
  id         String @id @default(cuid())
  roomId     Int    @map("room_id")
  room       Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reporterId String @map("reporter_id")
  // Restrict: report history must survive a hard-delete attempt on the reporter.
  reporter   User   @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Restrict)

  reason      ReportReason
  description String?
  status      ReportStatus @default(pending)

  resolvedById   String?   @map("resolved_by_id")
  resolvedBy     User?     @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime? @map("resolved_at")
  resolutionNote String?   @map("resolution_note")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([roomId])
  @@index([reporterId])
  @@index([status])
  @@map("reports")
}

model RoomModeration {
  id     String @id @default(cuid())
  roomId Int    @map("room_id")
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  adminId String @map("admin_id")
  // Restrict: moderation history must stay attributable to the admin who acted.
  admin   User   @relation(fields: [adminId], references: [id], onDelete: Restrict)

  action ModerationAction
  note   String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([roomId])
  @@index([adminId])
  @@index([action])
  @@map("room_moderations")
}
