# Copy this file to .env.production on the VPS and replace every placeholder.
# Never commit the real .env.production file.

NODE_ENV=production
PORT=3000

# PostgreSQL container credentials. Keep the password URL-safe: use only
# letters, numbers, hyphens, and underscores.
POSTGRES_DB=rental_room
POSTGRES_USER=roomrent
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://roomrent:replace_with_a_long_random_password@postgres:5432/rental_room?schema=public

# Redis is the Compose service name, not localhost.
REDIS_URL=redis://redis:6379

# Exact public frontend origin, without a trailing slash.
FRONTEND_URL=https://your-frontend-domain.com

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=20m
JWT_REFRESH_EXPIRES_IN=30d

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET=roomrent-images

# Configure a real production mail transport. Do not set DEV_OTP_CODE.
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=replace_with_mail_password
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=RoomRent

# Twilio Verify Service must have "Custom Verification Code" enabled.
SMS_PROVIDER=twilio_verify
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=00000000000000000000000000000000
TWILIO_VERIFY_SERVICE_SID=VA00000000000000000000000000000000
