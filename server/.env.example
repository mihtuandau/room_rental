# Copy to .env and fill in real values. Never commit .env itself.

# --- Database -----------------------------------------------------------------
# Matches `docker compose up -d` at the repo root: port 5433 so it never
# collides with a Postgres already installed on the host, and the postgis/postgis
# image so the postgis + unaccent extensions the schema needs are available.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/rental_room?schema=public"

# --- App ----------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
# Origin allowed by CORS — must match where the frontend actually runs.
# Changing this requires restarting the backend, or requests fail CORS with an
# opaque "Failed to fetch".
FRONTEND_URL="http://localhost:5000"

# --- Auth ---------------------------------------------------------------------
# Generate each with: openssl rand -hex 32  (must be different from each other)
JWT_ACCESS_SECRET="replace-me-with-a-32-plus-character-random-string"
JWT_REFRESH_SECRET="replace-me-with-a-different-32-plus-character-string"
JWT_ACCESS_EXPIRES_IN="20m"
JWT_REFRESH_EXPIRES_IN="30d"

# OAuth client id from Google Cloud Console (APIs & Services > Credentials).
# Only the client ID is needed — the backend verifies ID tokens sent by the
# frontend and never performs the redirect flow, so no client secret is used.
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
# Optional email OTP delivery through Resend. In development, codes are logged
# with a DEV ONLY marker when these values are omitted.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Tro Oi <no-reply@example.com>"

# Gmail SMTP (recommended for local testing without a domain). Use a Google
# App Password, never the normal Gmail password.
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=465
MAIL_USER="your-account@gmail.com"
MAIL_PASSWORD="your-16-character-app-password"
MAIL_FROM="your-account@gmail.com"
MAIL_FROM_NAME="Tro Oi"
# --- Cloudinary (image uploads) -----------------------------------------------

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# --- Redis (BullMQ notification jobs) -----------------------------------------
# Also from docker compose. A hosted Redis works too, but set its eviction
# policy to noeviction — BullMQ can lose queued jobs under the default policy.
REDIS_URL="redis://localhost:6379"
