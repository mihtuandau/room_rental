# Copy to .env and fill in real values. Never commit .env itself.

# --- Database -----------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/rental_room?schema=public"

# --- App ----------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
# Origin allowed by CORS — must match where the frontend actually runs
FRONTEND_URL="http://localhost:3001"

# --- Auth ---------------------------------------------------------------------
# Generate each with: openssl rand -hex 32  (must be different from each other)
JWT_ACCESS_SECRET="replace-me-with-a-32-plus-character-random-string"
JWT_REFRESH_SECRET="replace-me-with-a-different-32-plus-character-string"
JWT_ACCESS_EXPIRES_IN="20m"
JWT_REFRESH_EXPIRES_IN="30d"

# OAuth client id from Google Cloud Console (APIs & Services > Credentials).
# Only the client ID is needed — the backend verifies ID tokens sent by the
# frontend and never performs the redirect flow, so no client secret is used.
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"

# --- Cloudinary (image uploads) -----------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# --- Redis (BullMQ notification jobs) -----------------------------------------
REDIS_URL="redis://default:password@host:port"
