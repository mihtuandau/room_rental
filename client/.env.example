# Copy to .env.local and fill in. Never commit .env.local.

# Server-only (NO NEXT_PUBLIC_ prefix): the real backend origin. Used by Server
# Components and Route Handlers, so the backend URL never ships to the browser.
API_URL="http://localhost:3000"

# This app's own origin — used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:5000"

# Same OAuth client id the backend verifies tokens against. In Google Cloud
# Console this app's origin must be listed under "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
